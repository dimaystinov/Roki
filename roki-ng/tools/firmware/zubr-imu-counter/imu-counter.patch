+#ifndef IMU_PROGRESS_H
+#define IMU_PROGRESS_H
+#include <stdint.h>
+// Progress of distinct sensor timestamps, never host reads or polling loops.
+struct ImuProgress {
+  uint32_t sequence = 0;
+  uint64_t timestamp = 0;
+  bool initialized = false;
+  void observe(uint64_t ticks) {
+    if (!initialized || ticks != timestamp) {
+      timestamp = ticks;
+      initialized = true;
+      ++sequence;
+    }
+  }
+};
+#endif
