+static uint16_t imuSnapshot[12];
+static void captureImuSnapshot() {
+  const Quaternion &q = hwImu.mQuaternion;
+  const uint32_t seq = q.progress.sequence;
+  const uint32_t ticks = uint32_t(q.progress.timestamp);
+  imuSnapshot[0] = 0x4d49; // "IMU1", little endian
+  imuSnapshot[1] = 0x3155;
+  imuSnapshot[2] = uint16_t(seq);
+  imuSnapshot[3] = uint16_t(seq >> 16);
+  imuSnapshot[4] = uint16_t(ticks);
+  imuSnapshot[5] = uint16_t(ticks >> 16);
+  imuSnapshot[6] = uint16_t(q.mIntX);
+  imuSnapshot[7] = uint16_t(q.mIntY);
+  imuSnapshot[8] = uint16_t(q.mIntZ);
+  imuSnapshot[9] = uint16_t(q.mIntW);
+  imuSnapshot[10] = uint16_t(hwImu.mError);
+  imuSnapshot[11] = q.progress.initialized ? 1 : 0;
+}
 
